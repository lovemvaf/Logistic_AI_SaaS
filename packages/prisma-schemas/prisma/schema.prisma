  pickupAddress     String?   @map("pickup_address")
  pickupLat         Decimal?  @map("pickup_lat")
  pickupLng         Decimal?  @map("pickup_lng")
  pickupTripId      String?   @map("pickup_trip_id")
  pickupDriverId    String?   @map("pickup_driver_id")
  pickupScheduledAt DateTime? @map("pickup_scheduled_at")
  pickedUpAt        DateTime? @map("picked_up_at")
  returnType        String    @default("REFUND")
  notes             String?
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order        Order              @relation(fields: [orderId], references: [id])
  reason       ReturnReason?      @relation(fields: [reasonId], references: [id])
  pickupTrip   Trip?              @relation("PickupTrip", fields: [pickupTripId], references: [id])
