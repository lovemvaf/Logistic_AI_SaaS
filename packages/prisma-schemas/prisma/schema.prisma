// =========================================================================
// GATE G4 ENTERPRISE MODELS:
// 1. Global Geography & Transport Corridors (TP Dong Nai 2026 - 95 Units + External Ports)
// 2. Container, Tractor, Chassis & Yard/Depot/EIR (FORCE RLS)
// 3. Freight Commercial, RFQ/Quotes, Bookings, DEM/DET, AR/AP & Disputes (FORCE RLS)
// 4. Trade / XNK Documents, Customs Declarations & HS Advisory Approval (FORCE RLS)
// =========================================================================

model AdministrativeUnit {
  id                 String   @id @default(uuid())
  canonicalName      String   @map("canonical_name")
  normalizedName     String   @map("normalized_name")
  unitType           String   @map("unit_type") // WARD | COMMUNE
  provinceName       String   @default("Thành phố Đồng Nai") @map("province_name")
  provinceCode       String   @default("DONG_NAI_2026") @map("province_code")
  corridor           String?  // NORTH | CENTRAL | SOUTH
  officialCode       String?  @map("official_code")
  officialCodeStatus String   @default("PENDING_OFFICIAL_CODE") @map("official_code_status")
  boundaryStatus     String   @default("NO_OFFICIAL_POLYGON") @map("boundary_status")
  sourceDoc          String   @default("NQ_30_2026_QH16 / NQ_1662_2025") @map("source_doc")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  aliases           AdministrativeAlias[]
  boundaryVersions  AdministrativeBoundaryVersion[]
  facilities        LogisticsFacility[]

  @@unique([provinceCode, unitType, normalizedName])
  @@index([unitType])
  @@index([corridor])
  @@index([normalizedName])
  @@map("administrative_units")
}

model AdministrativeAlias {
  id              String   @id @default(uuid())
  unitId          String   @map("unit_id")
  aliasName       String   @map("alias_name")
  normalizedAlias String   @map("normalized_alias")
  aliasType       String   @default("PRE_2025_NAME") @map("alias_type") // PRE_2025_NAME | COMMON_VARIANT | ABBREVIATION
  sourceDoc       String?  @map("source_doc")
  createdAt       DateTime @default(now()) @map("created_at")

  unit AdministrativeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("administrative_aliases")
}

model AdministrativeBoundaryVersion {
  id              String    @id @default(uuid())
  unitId          String    @map("unit_id")
  versionTag      String    @map("version_tag")
  sourceDoc       String    @map("source_doc")
  sourceUrl       String?   @map("source_url")
  officialCode    String?   @map("official_code")
  geometryGeoJson Json?     @map("geometry_geojson")
  boundaryStatus  String    @default("NO_OFFICIAL_POLYGON") @map("boundary_status")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  unit AdministrativeUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, versionTag])
  @@index([boundaryStatus])
  @@map("administrative_boundary_versions")
}

model LogisticsFacility {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  facilityType         String   @map("facility_type") // ICD | SEAPORT | INDUSTRIAL_PARK | BORDER_GATE | AIRPORT | DEPOT
  administrativeUnitId String?  @map("administrative_unit_id")
  localityName         String   @map("locality_name")
  provinceCode         String   @default("DONG_NAI_2026") @map("province_code")
  outsideCity          Boolean  @default(false) @map("outside_city")
  corridor             String?
  lat                  Decimal?
  lng                  Decimal?
  gateCount            Int      @default(4) @map("gate_count")
  capacityTeu          Int?     @map("capacity_teu")
  sourceType           String   @default("SYNTHETIC_DEMO") @map("source_type") // OFFICIAL_REF | SYNTHETIC_DEMO
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  administrativeUnit AdministrativeUnit?        @relation(fields: [administrativeUnitId], references: [id], onDelete: SetNull)
  geofences          FacilityGeofence[]
  originCorridors    TransportCorridor[]        @relation("CorridorOrigin")
  destCorridors      TransportCorridor[]        @relation("CorridorDest")
  roadRestrictions   RoadRestriction[]
  queueObservations  TerminalQueueObservation[]
  originBookings     FreightBooking[]           @relation("BookingOriginFacility")
  destBookings       FreightBooking[]           @relation("BookingDestFacility")

  @@index([facilityType])
  @@index([outsideCity])
  @@index([corridor])
  @@index([provinceCode])
  @@map("logistics_facilities")
}

model FacilityGeofence {
  id             String   @id @default(uuid())
  facilityId     String   @map("facility_id")
  name           String
  radiusMeters   Int      @default(500) @map("radius_meters")
  polygonGeoJson Json?    @map("polygon_geojson")
  boundarySource String   @default("SYNTHETIC_RADIUS_PLACEHOLDER") @map("boundary_source")
  createdAt      DateTime @default(now()) @map("created_at")

  facility LogisticsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("facility_geofences")
}

model TransportCorridor {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  corridorTag      String   @map("corridor_tag") // NORTH | CENTRAL | SOUTH
  highwayCode      String   @map("highway_code")
  originFacilityId String?  @map("origin_facility_id")
  destFacilityId   String?  @map("dest_facility_id")
  nominalKm        Decimal  @map("nominal_km")
  typicalMinutes   Int      @map("typical_minutes")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  originFacility   LogisticsFacility? @relation("CorridorOrigin", fields: [originFacilityId], references: [id], onDelete: SetNull)
  destFacility     LogisticsFacility? @relation("CorridorDest", fields: [destFacilityId], references: [id], onDelete: SetNull)
  roadRestrictions RoadRestriction[]

  @@index([corridorTag])
  @@map("transport_corridors")
}

model RoadRestriction {
  id              String   @id @default(uuid())
  corridorId      String?  @map("corridor_id")
  facilityId      String?  @map("facility_id")
  title           String
  maxTonnageTons  Decimal? @map("max_tonnage_tons")
  maxHeightM      Decimal? @map("max_height_m")
  restrictedHours String?  @map("restricted_hours")
  severity        String   @default("WARNING") // WARNING | BLOCKING
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  corridor TransportCorridor? @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  facility LogisticsFacility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([corridorId])
  @@index([facilityId])
  @@map("road_restrictions")
}

model TerminalQueueObservation {
  id                 String   @id @default(uuid())
  facilityId         String   @map("facility_id")
  observedAt         DateTime @default(now()) @map("observed_at")
  waitMinutes        Int      @map("wait_minutes")
  queueLength        Int      @default(0) @map("queue_length")
  sourceLabel        String   @default("SYNTHETIC_DEMO") @map("source_label")
  isOfficialTelemetry Boolean @default(false) @map("is_official_telemetry")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  facility LogisticsFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, observedAt])
  @@map("terminal_queue_observations")
}

// ----------------------- Equipment & Container Lifecycle -----------------------
model TractorUnit {
  id                String   @id @default(uuid())
  tenantId          String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  unitCode          String   @map("unit_code")
  plateNumber       String   @map("plate_number")
  horsePower        Int      @default(420) @map("horse_power")
  emissionStd       String   @default("EURO5") @map("emission_std")
  status            String   @default("AVAILABLE") // AVAILABLE | IN_TRANSIT | MAINTENANCE | RETIRED
  currentFacilityId String?  @map("current_facility_id")
  lat               Decimal?
  lng               Decimal?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant      Tenant                        @relation(fields: [tenantId], references: [id])
  assignments EquipmentAssignment[]
  gateEvents  ContainerGateEvent[]
  eirs        EquipmentInterchangeReceipt[]

  @@unique([tenantId, unitCode])
  @@unique([tenantId, plateNumber])
  @@index([tenantId, status])
  @@map("tractor_units")
}

model ChassisUnit {
  id                String   @id @default(uuid())
  tenantId          String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  chassisCode       String   @map("chassis_code")
  plateNumber       String   @map("plate_number")
  axleCount         Int      @default(3) @map("axle_count")
  compatibleSizes   String[] @map("compatible_sizes")
  status            String   @default("AVAILABLE") // AVAILABLE | IN_USE | MAINTENANCE
  currentFacilityId String?  @map("current_facility_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant      Tenant                        @relation(fields: [tenantId], references: [id])
  assignments EquipmentAssignment[]
  gateEvents  ContainerGateEvent[]
  eirs        EquipmentInterchangeReceipt[]

  @@unique([tenantId, chassisCode])
  @@unique([tenantId, plateNumber])
  @@index([tenantId, status])
  @@map("chassis_units")
}

model ContainerEquipment {
  id              String    @id @default(uuid())
  tenantId        String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  containerNo     String    @map("container_no")
  sizeType        String    @default("40HC") @map("size_type") // 20GP | 40GP | 40HC | 40RF | 45HC
  isoCode         String    @default("45G1") @map("iso_code")
  tareWeightKg    Int       @default(3800) @map("tare_weight_kg")
  maxPayloadKg    Int       @default(26680) @map("max_payload_kg")
  reeferTempC     Decimal?  @map("reefer_temp_c")
  ownershipType   String    @default("CARRIER_OWNED") @map("ownership_type") // CARRIER_OWNED | SOC | LEASED
  status          String    @default("EMPTY_AT_DEPOT")
  currentSealNo   String?   @map("current_seal_no")
  lastInspectedAt DateTime? @map("last_inspected_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant      Tenant                        @relation(fields: [tenantId], references: [id])
  assignments EquipmentAssignment[]
  yardSlots   YardSlot[]
  gateEvents  ContainerGateEvent[]
  eirs        EquipmentInterchangeReceipt[]
  shipments   FreightShipment[]

  @@unique([tenantId, containerNo])
  @@index([tenantId, status])
  @@index([sizeType])
  @@map("container_equipments")
}

model EquipmentAssignment {
  id           String   @id @default(uuid())
  tenantId     String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  tractorId    String?  @map("tractor_id")
  chassisId    String?  @map("chassis_id")
  containerId  String?  @map("container_id")
  driverId     String?  @map("driver_id")
  freightLegId String?  @map("freight_leg_id")
  bookingId    String?  @map("booking_id")
  status       String   @default("RESERVED") // RESERVED | ACTIVE | COMPLETED | CANCELLED
  startAt      DateTime @map("start_at")
  endAt        DateTime @map("end_at")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  tractor    TractorUnit?        @relation(fields: [tractorId], references: [id], onDelete: SetNull)
  chassis    ChassisUnit?        @relation(fields: [chassisId], references: [id], onDelete: SetNull)
  container  ContainerEquipment? @relation(fields: [containerId], references: [id], onDelete: SetNull)
  freightLeg FreightLeg?         @relation(fields: [freightLegId], references: [id], onDelete: SetNull)
  booking    FreightBooking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tractorId, startAt, endAt])
  @@index([chassisId, startAt, endAt])
  @@index([containerId, startAt, endAt])
  @@index([driverId, startAt, endAt])
  @@map("equipment_assignments")
}

// ----------------------- Yard / Depot / EIR -----------------------
model Yard {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
