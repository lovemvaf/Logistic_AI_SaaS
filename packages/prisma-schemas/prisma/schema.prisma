generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Outbox pattern: sự kiện nghiệp vụ được ghi cùng transaction với thay đổi
/// dữ liệu, sau đó một worker gửi đi (Kafka / webhook). Nhờ vậy không còn
/// trường hợp "đơn hàng đã tạo nhưng event chưa phát" hoặc ngược lại.
///
/// Bảng này thuộc lớp platform (đọc/ghi xuyên tenant) nên không bật RLS.
model OutboxEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique @default(uuid()) @map("event_id")
  schemaVersion    String    @default("1.0") @map("schema_version")
  aggregateId      String?   @map("aggregate_id")
  payloadHash      String?   @map("payload_hash")
  correlationId    String?   @map("correlation_id")
  tenantId         String?   @map("tenant_id")
  /// Kênh gửi: KAFKA | WEBHOOK
  channel          String
  /// Tên topic/event, ví dụ `order.created`
  topic            String
  payload          Json
  /// PENDING | PROCESSING | SENT | FAILED | DEAD_LETTER
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  lastError        String?   @map("last_error")
  deadLetterReason String?   @map("dead_letter_reason")
  lockedBy         String?   @map("locked_by")
  leaseUntil       DateTime? @map("lease_until")
  /// Thời điểm sớm nhất được gửi lại (backoff khi thất bại)
  availableAt      DateTime  @default(now()) @map("available_at")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([status, leaseUntil])
  @@index([tenantId])
  @@index([topic])
  @@map("outbox_events")
}

model EventConsumptionLedger {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  consumerGroup String   @map("consumer_group")
  tenantId      String?  @map("tenant_id")
  topic         String
  processedAt   DateTime @default(now()) @map("processed_at")

  @@unique([eventId, consumerGroup])
  @@index([tenantId])
  @@map("event_consumption_ledger")
}

model ApiIdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String   @default("public") @map("tenant_id")
  principalId    String   @default("anon") @map("principal_id")
  operation      String
  idempotencyKey String   @map("idempotency_key")
  bodySha256     String   @map("body_sha256")
  state          String   @default("PROCESSING")
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, principalId, operation, idempotencyKey])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("api_idempotency_records")
}

model Tenant {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  logoUrl           String?           @map("logo_url")
  planId            String?           @map("plan_id")
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id])
  dbSchemaName      String            @unique @map("db_schema_name")
  status            String            @default("PENDING")
  maxUsers          Int               @default(10) @map("max_users")
  maxWarehouses     Int               @default(3) @map("max_warehouses")
  maxVehicles       Int               @default(10) @map("max_vehicles")
  maxApiCallsPerDay Int               @default(10000) @map("max_api_calls_per_day")
  settingsJson      String            @default("{}") @map("settings_json")
  createdAt         DateTime          @default(now()) @map("created_at")
  syncVersion       Int               @default(1) @map("sync_version")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  apiKeys              TenantApiKey[]
  clientApiKeys        ClientApiKey[]
  publicTrackingGrants PublicTrackingGrant[]
  featureFlags         FeatureFlag[]
  settings             TenantSetting[]
  invoices             Invoice[]
  paymentTransactions  PaymentTransaction[]
  apiUsageDaily        ApiUsageDaily[]
  uiConfig             TenantUiConfig?
  tractors             TractorUnit[]
  chassisUnits         ChassisUnit[]
  containers           ContainerEquipment[]
  equipmentAssignments EquipmentAssignment[]
  yards                Yard[]
  yardSlots            YardSlot[]
  containerGateEvents  ContainerGateEvent[]
  eirs                 EquipmentInterchangeReceipt[]
  contractRates        ContractRate[]
  surchargeRules       SurchargeRule[]
  demDetRules          DemDetRule[]
  freightRfqs          FreightRFQ[]
  freightQuotes        FreightQuote[]
  quoteLines           QuoteLine[]
  freightBookings      FreightBooking[]
  freightShipments     FreightShipment[]
  freightLegs          FreightLeg[]
  freightInvoices      FreightInvoice[]
  freightLedgerEntries FreightLedgerEntry[]
  paymentAllocations   PaymentAllocation[]
  disputeCases         DisputeCase[]
  tradeDocuments       TradeDocument[]
  tradeDocVersions     TradeDocumentVersion[]
  customsDeclarations  CustomsDeclaration[]
  customsStatusEvents  CustomsStatusEvent[]
  hsCodeSuggestions    HSCodeSuggestion[]
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  priceMonthly  Decimal  @map("price_monthly")
  maxUsers      Int      @map("max_users")
  maxWarehouses Int      @map("max_warehouses")
  maxVehicles   Int      @map("max_vehicles")
  featuresJson  String   @default("{}") @map("features_json")
  priceCurrency String   @default("USD") @map("price_currency")
  description   String?  @map("description")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("subscription_plans")
}

model SystemAuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  actorId      String   @map("actor_id")
  actorEmail   String   @map("actor_email")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  oldValues    String?  @map("old_values")
  newValues    String?  @map("new_values")
  ipAddress    String   @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([resourceType])
  @@index([createdAt])
  @@map("system_audit_logs")
}

model SystemAdmin {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  status           String    @default("ACTIVE")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("system_admins")
}

model TenantUser {
  id               String    @id @default(uuid())
  tenantId         String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  email            String
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  status           String    @default("ACTIVE")
  lastLogin        DateTime? @map("last_login")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt        DateTime  @default(now()) @map("created_at")
  syncVersion      Int       @default(1) @map("sync_version")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles             UserRole[]
  Branch            Branch[]
  Warehouse         Warehouse[]
  Task              Task[]
  Driver            Driver?
  CycleCount        CycleCount[]
  Adjustment        Adjustment[]
  ScanLog           ScanLog[]
  StockMovement     StockMovement[]
  StaffShift        StaffShift[]
  EquipmentCheckout EquipmentCheckout[]

  @@unique([tenantId, email])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([tenantId])
  @@map("tenant_users")
}

model CustomRole {
  id              String    @id @default(uuid())
  tenantId        String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  name            String
  isSystemDefault Boolean   @default(false) @map("is_system_default")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  permissions RolePermission[]
  users       UserRole[]

  @@index([tenantId])
  @@map("custom_roles")
}

model RolePermission {
  tenantId String @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  roleId   String @map("role_id")
  resource String
  action   String

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, resource, action])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId String @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  userId   String @map("user_id")
  roleId   String @map("role_id")

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model Branch {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  type        String
  code        String
  name        String
  address     String
  lat         Decimal?
  lng         Decimal?
  capacityCbm Decimal?  @map("capacity_cbm")
  managerId   String?   @map("manager_id")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  manager TenantUser? @relation(fields: [managerId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid())
  tenantId  String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  name      String
  code      String
  address   String
  status    String    @default("ACTIVE")
  managerId String?   @map("manager_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  manager           TenantUser?         @relation(fields: [managerId], references: [id])
  zones             Zone[]
  Bin               Bin[]
  Inventory         Inventory[]
  StockMovement     StockMovement[]
  WavePicking       WavePicking[]
  Task              Task[]
  CycleCount        CycleCount[]
  Adjustment        Adjustment[]
  ScanLog           ScanLog[]
  PackStationLog    PackStationLog[]
  StaffShift        StaffShift[]
  EquipmentCheckout EquipmentCheckout[]

  @@unique([tenantId, code])
  @@index([status])
  @@index([managerId])
  @@index([tenantId])
  @@map("warehouses")
}

model Zone {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  code        String
  type        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  racks     Rack[]

  @@unique([warehouseId, code])
  @@index([tenantId])
  @@map("zones")
}

model Rack {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  zoneId    String   @map("zone_id")
  code      String
  aisle     String
  rows      Int
  levels    Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone Zone  @relation(fields: [zoneId], references: [id])
  bins Bin[]

  @@unique([zoneId, code])
  @@index([tenantId])
  @@map("racks")
}

model Bin {
  id           String   @id @default(uuid())
  tenantId     String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  rackId       String   @map("rack_id")
  warehouseId  String   @map("warehouse_id")
  barcode      String
  rowIndex     Int      @map("row_index")
  levelIndex   Int      @map("level_index")
  maxWeightKg  Decimal  @default(1000) @map("max_weight_kg")
  maxVolumeCbm Decimal  @default(1.5) @map("max_volume_cbm")
  posX         Int?     @map("pos_x")
  posY         Int?     @map("pos_y")
  posZ         Int?     @map("pos_z")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rack      Rack        @relation(fields: [rackId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  inventory Inventory[]

  @@unique([tenantId, barcode])
  @@index([rackId])
  @@index([warehouseId])
  @@index([tenantId])
  @@map("bins")
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  name      String
  parentId  String?  @map("parent_id")
  slug      String
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  sku         String
  name        String
  barcode     String?
  categoryId  String?   @map("category_id")
  weightKg    Decimal   @default(0) @map("weight_kg")
  volumeCbm   Decimal   @default(0) @map("volume_cbm")
  description String?
  imageUrl    String?   @map("image_url")
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category        Category?        @relation(fields: [categoryId], references: [id])
  inventory       Inventory[]
  orderItems      OrderItem[]
  Task            Task[]
  TaskItem        TaskItem[]
  demandForecasts DemandForecast[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([categoryId])
  @@index([status])
  @@index([tenantId])
  @@map("products")
}

model Inventory {
  id                String    @id @default(uuid())
  tenantId          String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  warehouseId       String    @map("warehouse_id")
  binId             String    @map("bin_id")
  productId         String    @map("product_id")
  batchNumber       String?   @map("batch_number")
  expiryDate        DateTime? @map("expiry_date")
  lpn               String?
  quantityOnHand    Int       @default(0) @map("quantity_on_hand")
  quantityAllocated Int       @default(0) @map("quantity_allocated")
  status            String    @default("AVAILABLE")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  bin        Bin             @relation(fields: [binId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  movements  StockMovement[]
  Adjustment Adjustment[]

  @@unique([binId, productId, batchNumber, lpn])
  @@index([warehouseId])
  @@index([productId])
  @@index([warehouseId, productId])
  @@index([tenantId])
  @@map("inventory")
}

model StockMovement {
  id                String   @id @default(uuid())
  tenantId          String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  inventoryId       String   @map("inventory_id")
  warehouseId       String   @map("warehouse_id")
  transactionType   String   @map("transaction_type")
  quantityChange    Int      @map("quantity_change")
  balanceAfter      Int      @map("balance_after")
  referenceDocument String?  @map("reference_document")
  reasonCode        String?  @map("reason_code")
  actorId           String   @map("actor_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  inventory Inventory   @relation(fields: [inventoryId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  actor     TenantUser? @relation(fields: [actorId], references: [id])

  @@index([warehouseId])
  @@index([inventoryId])
  @@index([createdAt])
  @@index([inventoryId, createdAt])
  @@index([tenantId])
  @@map("stock_movements")
}

model WavePicking {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  warehouseId String    @map("warehouse_id")
  waveNumber  String @map("wave_number")
  status      String    @default("NEW")
  totalOrders Int       @default(0) @map("total_orders")
  totalItems  Int       @default(0) @map("total_items")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  tasks     Task[]

  @@unique([tenantId, waveNumber])
  @@index([warehouseId])
  @@index([status])
  @@index([tenantId])
  @@map("wave_picking")
}

model Task {
  id                String    @id @default(uuid())
  tenantId          String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  warehouseId       String    @map("warehouse_id")
  taskType          String    @map("task_type")
  status            String    @default("PENDING")
  priority          Int       @default(0)
  assigneeId        String?   @map("assignee_id")
  sourceBinId       String?   @map("source_bin_id")
  targetBinId       String?   @map("target_bin_id")
  productId         String    @map("product_id")
  quantityRequested Int       @map("quantity_requested")
  quantityActual    Int?      @map("quantity_actual")
  waveId            String?   @map("wave_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  assignee  TenantUser?  @relation(fields: [assigneeId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  wave      WavePicking? @relation(fields: [waveId], references: [id])
  TaskItem  TaskItem[]
  ScanLog   ScanLog[]

  @@index([warehouseId])
  @@index([assigneeId])
  @@index([status])
  @@index([productId])
  @@index([tenantId])
  @@map("tasks")
}

model Client {
  id        String    @id @default(uuid())
  tenantId  String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  name      String
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users    ClientUser[]
  orders   Order[]
  webhooks ClientWebhook[]
  apiKeys          ClientApiKey[]
  invoices         Invoice[]
  freightRfqs      FreightRFQ[]
  freightQuotes    FreightQuote[]
  freightBookings  FreightBooking[]
  freightShipments FreightShipment[]
  freightInvoices  FreightInvoice[]
  disputeCases     DisputeCase[]
  tradeDocuments   TradeDocument[]
  contractRates    ContractRate[]

  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
  @@map("clients")
}

model ClientUser {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  clientId  String   @map("client_id")
  email     String
  fullName  String   @map("full_name")
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([email])
  @@index([tenantId])
  @@map("client_users")
}

model Order {
  id                    String    @id @default(uuid())
  tenantId              String    @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  trackingCode          String    @unique @map("tracking_code")
  clientId              String?   @map("client_id")
  clientOrderRef        String?   @map("client_order_ref")
  status                String
  recipientName         String    @map("recipient_name")
  recipientPhone        String    @map("recipient_phone")
  recipientAddress      String    @map("recipient_address")
  lat                   Decimal?
  lng                   Decimal?
  codAmount             Decimal   @default(0) @map("cod_amount")
  shippingFee           Decimal   @map("shipping_fee")
  notes                 String?
  cancelledReason       String?   @map("cancelled_reason")
  returnStatus          String?   @map("return_status")
  returnPolicy          String?   @map("return_policy")
  returnEligibleUntil   DateTime? @map("return_eligible_until")
  podImageUrl           String?   @map("pod_image_url")
  driverId              String?   @map("driver_id")
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date")
  actualDeliveryTime    DateTime? @map("actual_delivery_time")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  client         Client?              @relation(fields: [clientId], references: [id])
  driver         Driver?              @relation(fields: [driverId], references: [id])
  items          OrderItem[]
  events         OrderTrackingEvent[]
  PackStationLog PackStationLog[]
  deliveries     Delivery[]
  tripStops      TripStop[]
  returnRequests ReturnRequest[]

  @@index([clientId])
  @@index([status])
  @@index([driverId])
  @@index([createdAt])
  @@index([trackingCode])
  @@index([recipientPhone])
  @@index([clientId, status])
  @@index([tenantId])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  tenantId         String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
  orderId          String   @map("order_id")
  productId        String   @map("product_id")
  quantity         Int
  returnedQuantity Int      @default(0) @map("returned_quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  returns ReturnItem[]

  @@index([orderId])
  @@index([tenantId])
  @@map("order_items")
}

model OrderTrackingEvent {
  id          String   @default(uuid())
  tenantId    String   @default(dbgenerated("public.app_current_tenant_id()")) @map("tenant_id")
