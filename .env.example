# ==============================================================================
# SmartLogi AI SaaS — Root Environment Template (DO NOT COMMIT REAL SECRETS)
# Copy to `.env` before running `docker compose up -d --build`.
# Cloudflare Worker secrets belong in `workers/ai-worker/.dev.vars` (see `.dev.vars.example`).
# ==============================================================================

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=smartlogi
APP_DB_USER=smartlogi_app
SEED_ON_START=true
FORCE_RESEED=false

# --- Auth & JWT ---
JWT_SECRET=change_me_at_least_32_chars_hex_secret

# --- Internal Service Tokens & GPS HMAC ---
AI_WORKER_URL=http://host.docker.internal:8787
AI_API_KEY=change_me_internal_ai_api_key
GPS_AUTH_TOKEN=change_me_gps_http_bearer_token
GPS_UDP_HMAC_SECRET=change_me_gps_udp_hmac_secret
GPS_UDP_ALLOW_LEGACY_UNAUTHENTICATED=false
WEBHOOK_AUTH_TOKEN=change_me_webhook_service_token

# --- Object Storage (LocalStack S3 in dev; S3/R2 in staging/prod) ---
S3_ENDPOINT=http://s3:4566
S3_BUCKET=smartlogi-pod
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

# --- Frontend Mode & Portals (`mock` or `api`) ---
NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_URL=/api/v1
PORTALS_PROXY_PORT=8080
CORS_ORIGINS=http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004

# --- Optional External Providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8081/api/v1/admin/auth/google/callback
GOOGLE_AUTO_PROVISION=false
SUPER_ADMIN_GOOGLE_EMAILS=
GOOGLE_GEOCODING_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_PROVIDER=console
SMS_PROVIDER=console
PUSH_PROVIDER=console
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

GATEWAY_RATE_LIMIT=1000
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
